<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setup_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="@string/setup_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center" />

    <EditText
        android:id="@+id/edit_ip"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:hint="@string/label_ip"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:singleLine="true" />

    <EditText
        android:id="@+id/edit_port"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/label_port"
        android:inputType="number"
        android:text="8554"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:singleLine="true" />

    <EditText
        android:id="@+id/edit_path"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/label_path"
        android:inputType="text"
        android:text="pc"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_mode"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/radio_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_low_latency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:checked="true"
            android:text="@string/mode_low_latency"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/radio_stable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_stable"
            android:textColor="@color/text_primary" />

    </RadioGroup>

    <TextView
        android:id="@+id/text_discovery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/searching_server"
        android:textColor="@color/accent"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/button_connect" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hint_same_config"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
