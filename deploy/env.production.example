# Plantilla de .env para PRODUCCIÓN. Copiar a <app>/.env y completar. NUNCA subir el .env real al repositorio ni pegarlo en chats.
APP_NAME="HR Media System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate
APP_URL=https://__DOMINIO__
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_media_system
DB_USERNAME=hrmedia
DB_PASSWORD=                   # contraseña fuerte propia de esta app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # solo con HTTPS activo
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Cabeceras de seguridad: enforce (por defecto) | report (solo avisa) | off
CSP_MODE=enforce

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=           # contraseña inicial; cámbiela al primer acceso
