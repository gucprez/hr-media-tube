# ============================================================================
#  HR Media System — sitio NUEVO de Nginx (archivo propio; no edita ningún sitio existente)
#
#  Copiar a:   /etc/nginx/sites-available/hrmedia.conf   y enlazar en sites-enabled
#  Cambie:     __DOMINIO__  (p. ej. hr.deportesxtra.com)   y   __APP_DIR__  (p. ej. /var/www/hrmedia)
#  Antes de recargar Nginx:  sudo nginx -t   (si falla, NO recargue)
#
#  No usa ningún puerto propio: comparte 80/443 con los demás sitios y se distingue por server_name.
#  Los puertos internos ya ocupados por otras apps (3001, 3002, 3004, 3005, 8010, 8020, 8090, 8100, 8443,
#  5555, 5556, 8001, 8002) NO se tocan ni se reutilizan: esta app corre con PHP-FPM por socket Unix.
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;
    root __APP_DIR__/public;
    index index.php;
    charset utf-8;

    client_max_body_size 20M;

    # Cabeceras que no repite Laravel (la CSP y el resto las pone la aplicación).
    server_tokens off;

    location / { try_files $uri $uri/ /index.php?$query_string; }

    # Service worker y manifest: sin caché larga para que las actualizaciones lleguen.
    location = /sw.js { add_header Cache-Control "no-cache"; try_files $uri =404; }
    location = /manifest.webmanifest { default_type application/manifest+json; add_header Cache-Control "no-cache"; try_files $uri =404; }

    # Archivos compilados con hash en el nombre: caché larga.
    location /build/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }

    # PHP SOLO a través de index.php: un archivo .php subido (p. ej. dentro de /storage) nunca se ejecuta.
    location = /index.php {
        fastcgi_pass unix:/run/php/hrmedia.sock;          # pool propio, ver deploy/php-fpm-hrmedia.conf.example
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 60s;
    }
    location ~ \.php$ { return 404; }

    # Nunca servir archivos ocultos (.env, .git) ni el código.
    # OJO: /storage SÍ debe servirse (enlace public/storage -> storage/app/public: logo de la empresa).
    # Los archivos privados no están ahí: viven en storage/app/private y solo salen por la aplicación (sesión + permiso).
    location ~ /\.(?!well-known).* { deny all; }
    location ~* ^/(vendor|bootstrap|database|tests)/ { deny all; }
}

# HTTPS: ejecute  sudo certbot --nginx -d __DOMINIO__  (certbot añade el bloque 443 y la redirección en ESTE archivo).
